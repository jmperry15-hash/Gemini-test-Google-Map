# GOOGLE_MAPS_PLATFORM_KEY: Required by this app.
# Copy this file to .env.local and paste a Maps Platform key.
# Enable Maps JavaScript API, Routes API, Places API (New), and Geocoding API.
# AI Studio injects the same name from the Secrets panel.
GOOGLE_MAPS_PLATFORM_KEY=

# GEMINI_API_KEY: Injected by AI Studio. This app does not call Gemini.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
